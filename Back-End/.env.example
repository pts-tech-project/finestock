# Server
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Path to Front-End/dist (production). Example: /var/www/finestockProd
FRONTEND_DIST=

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# MySQL
DB_NAME=finstock
DB_USER=finstock
DB_PASSWORD=
DB_HOST=217.154.54.148
DB_PORT=3306

# Email
# ethereal = TEST ONLY (fake inbox + preview URL, does NOT reach Gmail/etc.)
# Real delivery options:
#   1) Resend: set RESEND_API_KEY from https://resend.com (free tier)
#   2) Custom SMTP: set SMTP_HOST, SMTP_USER, SMTP_PASS
EMAIL_PROVIDER=ethereal
RESEND_API_KEY=
SMTP_FROM="FinStock <onboarding@resend.dev>"

# Optional custom SMTP (Gmail, Outlook, Mailgun, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
